{
  "name": "oatschema",
  "version": "0.0.1",
  "description": "OATS (Open Annotation Task Schemas) JSON schemas, bundled for JavaScript and TypeScript.",
  "keywords": [
    "oats",
    "json-schema",
    "annotation",
    "schema",
    "machine-learning"
  ],
  "homepage": "https://oatschema.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oatschema/oatschema-js.git"
  },
  "bugs": "https://github.com/oatschema/oatschema-js/issues",
  "license": "Apache-2.0",
  "author": "OATS maintainers <maintainers@oatschema.org>",
  "maintainers": [
    "OATS maintainers <maintainers@oatschema.org>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm test",
    "sync": "node --disable-warning=ExperimentalWarning scripts/sync-schemas.ts",
    "generate": "node --disable-warning=ExperimentalWarning scripts/generate.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
