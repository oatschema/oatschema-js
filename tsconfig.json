{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "oatschema": ["./src/index.ts"]
    }
  },
  "include": ["src", "scripts", "test"]
}
